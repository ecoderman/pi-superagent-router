{
  "name": "pi-router",
  "version": "0.4.0",
  "description": "Minimal superagent (Router) extension for Pi — layered memory, read-only main session, and visible workers",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/store.test.ts test/guard.test.ts test/config.test.ts test/workers.test.ts test/memory.test.ts test/prompt.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^24.0.0",
    "typebox": "^1.4.7",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-extension",
    "agent",
    "router",
    "superagent",
    "subagents",
    "orchestration"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "agents",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecoderman/pi-superagent-router.git"
  },
  "homepage": "https://github.com/ecoderman/pi-superagent-router#readme",
  "bugs": {
    "url": "https://github.com/ecoderman/pi-superagent-router/issues"
  }
}
